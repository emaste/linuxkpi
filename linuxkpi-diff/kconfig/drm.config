# drm-kmod: DRM core + amdgpu, radeon, i915, xe as modules.
# One scripts/config argument per line; applied on top of x86_64 defconfig.
-m DRM
-m DRM_AMDGPU
-e DRM_AMDGPU_SI
-e DRM_AMDGPU_CIK
-e DRM_AMDGPU_USERPTR
-e DRM_AMD_DC
-m DRM_RADEON
-m DRM_I915
-m DRM_XE
# not carried by drm-kmod
-d DRM_VIRTIO_GPU

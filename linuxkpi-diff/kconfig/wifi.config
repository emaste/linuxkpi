# Wireless drivers in FreeBSD's sys/contrib/dev, mirroring the default knobs
# in sys/modules/<driver>/Makefile: PCI only (USB/SDIO/AHB off), debugfs as
# FreeBSD sets it.  mac80211/cfg80211 are built as modules so they show up
# as named providers (linuxkpi_wlan implements them on FreeBSD).
-e WLAN
-m CFG80211
-m MAC80211

# iwlwifi: IWLWIFI_CONFIG_PM=1 IWLWIFI_CONFIG_ACPI=1 IWLWIFI_DEBUGFS=0; no dvm
-e WLAN_VENDOR_INTEL
-m IWLWIFI
-m IWLMVM
-m IWLMLD
-d IWLDVM
-d IWLWIFI_DEBUGFS

# mt76: MT76_PCI=1, USB/SDIO=0, debugfs off
-e WLAN_VENDOR_MEDIATEK
-m MT7615E
-m MT7915E
-m MT7921E
-d MT7921S
-d MT7921U
-m MT7925E
-d MT7925U
-m MT7996E

# rtw88: RTW88_PCI=1 RTW88_DEBUGFS=1, chips as in sys/modules/rtw88
-e WLAN_VENDOR_REALTEK
-m RTW88
-m RTW88_8723DE
-m RTW88_8814AE
-m RTW88_8821CE
-m RTW88_8822BE
-m RTW88_8822CE
-e RTW88_DEBUGFS

# rtw89: RTW89_PCI=1 RTW89_CONFIG_ACPI=1, all PCI chips, debugfs off
-m RTW89
-m RTW89_8851BE
-m RTW89_8852AE
-m RTW89_8852BE
-m RTW89_8852BTE
-m RTW89_8852CE
-m RTW89_8922AE
-d RTW89_DEBUGFS

# athk: ath10k/ath11k/ath12k PCI, ATHK_COMMON_ATH_DEBUG=1
-e WLAN_VENDOR_ATH
-e ATH_DEBUG
-m ATH10K
-m ATH10K_PCI
-d ATH10K_USB
-d ATH10K_SDIO
-m ATH11K
-m ATH11K_PCI
-d ATH11K_AHB
-d ATH11K_DEBUGFS
-d ATH11K_SPECTRAL
-m ATH12K
-d ATH12K_AHB
-d ATH12K_DEBUGFS

# brcm80211: BRCMFMAC_PCI=1, USB/SDIO=0, BRCMFMAC_DEBUG=1
-e WLAN_VENDOR_BROADCOM
-m BRCMUTIL
-m BRCMFMAC
-e BRCMFMAC_PCIE
-d BRCMFMAC_USB
-d BRCMFMAC_SDIO
-e BRCMDBG
